#!name=YouTube Enhance (Lite)
#!desc=YouTube 廣告攔截。整合 Choler / jimmyorz / Gx3dong 等社群維護模組的 URL-based 技巧。透過 ctier=L 廣告 tier 標記擋廣告片源（已驗證實際 log 樣本），不依賴 protobuf 與 SABR opt-out 腳本。
#!system=ios

[Rule]
# 強制 googlevideo / youtubei 走 TCP（QUIC/UDP 會繞過 MITM 與 URL 規則）
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

# 廣告基礎建設（DNS 級攔截）
DOMAIN,googleads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,2mdn.net,REJECT
DOMAIN-SUFFIX,tubemogul.com,REJECT
DOMAIN,premiumyva.appspot.com,REJECT

# 廣告片源（googlevideo.com 上的 ad video）
# &oad 舊版標記；ctier=A 是合法主內容，ctier=[B-Z] 全部視為廣告 tier
# 不用 (?!A) 負向先行（Surge URL-REGEX 在某些版本是 RE2 引擎，lookahead 不支援）
URL-REGEX,^https?:\/\/[\w-]+\.googlevideo\.com\/.+[?&]oad,REJECT-TINYGIF
URL-REGEX,^https?:\/\/[\w-]+\.googlevideo\.com\/.+[?&]ctier=[B-Z],REJECT-TINYGIF

# 廣告追蹤 / 統計
URL-REGEX,^https?:\/\/[\w-]+\.googlevideo\.com\/ptracking\?pltype=adhost,REJECT
URL-REGEX,^https?:\/\/(www|m)\.youtube\.com\/api\/stats\/ads,REJECT
URL-REGEX,^https?:\/\/(www|m)\.youtube\.com\/api\/stats\/atr,REJECT
URL-REGEX,^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?.*adformat,REJECT
URL-REGEX,^https?:\/\/(www|m)\.youtube\.com\/get_midroll_info,REJECT
URL-REGEX,^https?:\/\/(www|m)\.youtube\.com\/pagead\/,REJECT
URL-REGEX,^https?:\/\/(www|m)\.youtube\.com\/ptracking\?,REJECT
URL-REGEX,^https?:\/\/m\.youtube\.com\/_get_ads,REJECT
URL-REGEX,^https?:\/\/s0\.2mdn\.net\/ads\/,REJECT
URL-REGEX,^https?:\/\/stats\.tubemogul\.com\/stats\/,REJECT

# YouTube API 廣告 / log 端點
URL-REGEX,^https?:\/\/youtubei\.googleapis\.com\/.+ad_break,REJECT
URL-REGEX,^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,REJECT
URL-REGEX,^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/att\/get,REJECT

[MITM]
hostname = %APPEND% *.googlevideo.com, *.youtube.com, youtubei.googleapis.com
