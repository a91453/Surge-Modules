#!name=Github Private
#!desc=Access Github Private 

[MITM]
hostname = %APPEND% raw.githubusercontent.com, gist.githubusercontent.com

[Script]
Github Private = type=http-request, requires-body=0, pattern=^https?:\/\/(raw|gist)\.githubusercontent.com, script-path=https://raw.githubusercontent.com/a91453/Surge-Modules/main/scripts/tools/github.js
