[MITM]
skip-server-cert-verify = true
tcp-connection = true
client-source-address = 127.0.0.1, 192.168.1.0/24

# ====================================================================
# CA 憑證設定（必填，請自行生成後填入）
# --------------------------------------------------------------------
# 1. 在 Surge 中：設定 → MITM → 產生 CA 憑證並信任
# 2. 匯出 CA 至 .p12，將 base64 內容填到 ca-p12，passphrase 填到 ca-passphrase
# 3. 切勿將個人 CA 提交到公開倉庫
# --------------------------------------------------------------------
# ca-passphrase = YOUR_PASSPHRASE_HERE
# ca-p12 = YOUR_BASE64_P12_HERE
